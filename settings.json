{
  "model": "opus",
  "env": {
    "ECC_DISABLED_HOOKS": "pre:observe:continuous-learning,pre:write:doc-file-warning,pre:edit-write:gateguard-fact-force,session:start,pre:compact,stop:session-end",
    "GATEGUARD_BASH_ROUTINE_DISABLED": "1",
    "ECC_CONTEXT_MONITOR_COST_WARNINGS": "off"
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)", "Bash(git push --force:*)", "Bash(curl:*)"],
    "ask": ["Bash(git push:*)", "Bash(git commit:*)"]
  },
  "extraKnownMarketplaces": {
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "claude-community": { "source": { "source": "github", "repo": "anthropics/claude-plugins-community" } }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "eli5@claude-community": true,
    "code-review@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "agent-memory@claude-community": false
  }
}
